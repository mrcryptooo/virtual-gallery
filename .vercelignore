# Deploys ship apps/portfolio/dist only (see scripts/deploy.mjs). These entries
# are belt-and-braces for anyone who runs `vercel deploy` from the repo root.

# Pipeline input, never served (doc 07 §2): panorama masters are hundreds of MB
content-src/
.asset-cache/

# Built output is deployed directly, never as part of a source upload
apps/portfolio/dist/

# Not needed to build or serve
docs/
e2e/
packages/engine/test/fixtures/

# Neither of these should ever be part of a source upload: Vercel's own
# `installCommand` (pnpm install --frozen-lockfile) reinstalls dependencies
# server-side, and .git carries the repo's full history -- including
# objects for files deleted long ago (e.g. the old engine-rendered
# modern-museum package removed in 5e46e9f) that still take up real space
# in .git even though they're gone from the working tree. Neither was
# excluded before; `vercel deploy --archive=tgz` was sweeping both into
# the upload, which is what actually caused the failed ~482MB deploy.
.git/
node_modules/

# Vercel's zero-config Functions detection (this project has no framework
# preset) treats every .ts file under api/ as a route candidate,
# including test files and vitest.config.ts -- none of which export an
# HTTP handler. That inflated the function count past the Hobby plan's
# 12-Function-per-deployment limit (a second, distinct failure found
# right after fixing the .git/node_modules upload-size issue above).
# Excluding them from the source upload is enough: CI/local dev run them
# straight from git, unaffected by what a Vercel deploy uploads.
api/**/*.test.ts
api/vitest.config.ts
