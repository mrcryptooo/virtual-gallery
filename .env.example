# Copy to .env.local for local development. Never commit real values --
# .gitignore already excludes every .env* file except this one.

# Auto-provided by Vercel when a Blob store is linked to the project
# (`vercel blob create-store` / the Vercel dashboard). Required for
# api/submissions.ts, api/screenshots.ts, api/blob-upload.ts,
# api/screenshot-upload.ts, and both api/admin/* read routes.
BLOB_READ_WRITE_TOKEN=

# Telegram admin-notification foundation (see api/_lib/telegram.ts). Both
# must be set for notifications to send; if either is missing, every call
# to notifyAdmin() is a silent no-op -- the app never breaks or exposes an
# error just because these aren't configured yet. Provided separately by
# the project owner, never invented or committed here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Secures the daily-summary cron job (see api/cron/daily-summary.ts and
# the "crons" entry in vercel.json). Any random string you generate
# yourself (e.g. `openssl rand -hex 32`) -- not a third-party credential.
# Set it as a Vercel project environment variable and Vercel automatically
# sends it back as `Authorization: Bearer <value>` on every cron-triggered
# request, which is what the endpoint checks. Unset = the endpoint fails
# closed (401) for everyone, including the cron itself.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Real X OAuth 2.0 (Authorization Code + PKCE) + Supabase-backed sessions +
# admin RBAC (see api/_lib/oauth.ts, api/_lib/session.ts, api/_lib/adminAuth.ts,
# api/auth/*, supabase/migrations/0001_users_sessions.sql).
# ---------------------------------------------------------------------------

# Supabase project used purely as a Postgres database via the service-role
# key (server-side only -- never sent to the browser). Supabase Auth itself
# is NOT used; login is the hand-rolled X OAuth2/PKCE flow below.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# X/Twitter OAuth 2.0 confidential-client app credentials (owner-registered
# X Developer App, OAuth 2.0 enabled). Back api/auth/login.ts +
# api/auth/callback.ts. The callback URL registered in the X Developer
# Portal must exactly match https://<your-domain>/api/auth/callback.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Signs the seismic_session and seismic_oauth cookies (see api/_lib/session.ts,
# api/_lib/oauth.ts). Any random string you generate yourself
# (e.g. `openssl rand -hex 32`), not a third-party credential.
SESSION_SECRET=

# One-time admin bootstrap: the X user id (numeric, not the @handle) that
# should be granted the 'admin' role the first time that account signs in.
# Leave unset until the owner has a real X user id to bootstrap with --
# never invent a value here. See api/auth/callback.ts for how this is used.
INITIAL_ADMIN_X_USER_ID=
