# Copy to .env.local for local development. Never commit real values --
# .gitignore already excludes every .env* file except this one.

# Auto-provided by Vercel when a Blob store is linked to the project
# (`vercel blob create-store` / the Vercel dashboard). Required for
# api/submissions.ts, api/screenshots.ts, api/blob-upload.ts,
# api/screenshot-upload.ts, and both api/admin/* read routes.
BLOB_READ_WRITE_TOKEN=

# Shared secret for the api/admin/* read routes (see api/_lib/adminAuth.ts).
# Set this in the Vercel project's environment variables, never in a
# committed file. The admin routes fail closed (401) with this unset.
ADMIN_API_TOKEN=

# Telegram admin-notification foundation (see api/_lib/telegram.ts). Both
# must be set for notifications to send; if either is missing, every call
# to notifyAdmin() is a silent no-op -- the app never breaks or exposes an
# error just because these aren't configured yet. Provided separately by
# the project owner, never invented or committed here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
