# Copy to .env.local for local development. Never commit real values --
# .gitignore already excludes every .env* file except this one.

# Auto-provided by Vercel when a Blob store is linked to the project
# (`vercel blob create-store` / the Vercel dashboard). Required for
# api/submissions.ts, api/screenshots.ts, api/blob-upload.ts,
# api/screenshot-upload.ts, and both api/admin/* read routes.
BLOB_READ_WRITE_TOKEN=

# Shared secret for the api/admin/* read routes (see api/_lib/adminAuth.ts).
# Set this in the Vercel project's environment variables, never in a
# committed file. The admin routes fail closed (401) with this unset.
ADMIN_API_TOKEN=

# Telegram admin-notification foundation (see api/_lib/telegram.ts). Both
# must be set for notifications to send; if either is missing, every call
# to notifyAdmin() is a silent no-op -- the app never breaks or exposes an
# error just because these aren't configured yet. Provided separately by
# the project owner, never invented or committed here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Secures the daily-summary cron job (see api/cron/daily-summary.ts and
# the "crons" entry in vercel.json). Any random string you generate
# yourself (e.g. `openssl rand -hex 32`) -- not a third-party credential.
# Set it as a Vercel project environment variable and Vercel automatically
# sends it back as `Authorization: Bearer <value>` on every cron-triggered
# request, which is what the endpoint checks. Unset = the endpoint fails
# closed (401) for everyone, including the cron itself.
CRON_SECRET=

# ---------------------------------------------------------------------------
# NOT YET IMPLEMENTED -- documented contract only (see
# docs/reports/premium-experience-infrastructure-boundary.md for why).
# These do not exist in this project today: no OAuth callback route, no
# database, no session middleware. Setting these values alone would not
# turn on real authentication -- the code that would consume them has not
# been built, specifically so that no insecure placeholder auth ships.
# ---------------------------------------------------------------------------

# X/Twitter OAuth 2.0 app credentials (owner-registered X Developer App).
# Would back a future api/auth/login.ts + api/auth/callback.ts.
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=

# Session cookie signing secret for a future real login system. Any
# random string you generate yourself, not a third-party credential.
# SESSION_SECRET=

# Connection string for a real relational/document database (e.g. Vercel
# Postgres, Neon) -- Vercel Blob's flat object store cannot support
# "look up the user with this Twitter id" queries a real login system
# needs. Would back user accounts, sessions, and admin role assignment.
# DATABASE_URL=
