# Dependencies
node_modules/

# Build output
dist/
dist-packages/
*.tsbuildinfo

# Pipeline cache (doc 07 §6)
.asset-cache/

# Panorama masters: pipeline INPUT only (doc 07 §2), never deployed.
# 8K/16K masters are hundreds of MB per project — they live with the artist,
# not in git. The published package under public/projects/ is what ships.
content-src/*/panos/

# Test artifacts
coverage/
playwright-report/
test-results/

# Environment — only .env.example is tracked
.env
.env.*
!.env.example

# Local assistant tooling (not project source)
.claude/
__pycache__/

# Editor / OS noise
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# Vite
.vite/

.vercel

.env*.local
